{
  "name": "invoiceflow",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js && vitest run tests/ui",
    "test:ui": "vitest run tests/ui",
    "test:product": "npm test && npm run test:ui",
    "check": "for f in dist/*.js src/lib/*.js; do node --check \"$f\"; done"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5"
  },
  "devDependencies": {
    "c8": "^7.12.0",
    "jsdom": "^22.1.0",
    "vitest": "^5.1.0"
  }
}
